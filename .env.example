# =============================================================================
# НАСТРОЙКИ VK API
# =============================================================================
# Токен для отправки сообщений через VK API
# Получить: https://vk.com/dev (раздел "Мои приложения" -> "Создать приложение")
TOKEN_VK=your_vk_token_here

# ID пользователя VK, которому отправлять уведомления
# Узнать: https://vk.com/settings -> "ID вашей страницы"
VK_USER_ID=123456789
